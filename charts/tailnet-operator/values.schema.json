{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "agentImage", "agent", "replicas", "leaderElection", "env", "headscale", "policy", "console", "monitoring", "networkPolicy", "podSecurityContext", "securityContext", "resources", "namespace", "fullnameOverride", "imagePullSecrets"],
  "properties": {
    "fullnameOverride": {"type": "string", "maxLength": 53, "pattern": "^$|^[a-z]([-a-z0-9]*[a-z0-9])?$"},
    "namespace": {"type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "replicas": {"type": "integer", "minimum": 1},
    "leaderElection": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "topologySpreadConstraints": {"type": "array", "items": {"type": "object", "required": ["maxSkew", "topologyKey", "whenUnsatisfiable"], "properties": {
      "maxSkew": {"type": "integer", "minimum": 1},
      "topologyKey": {"type": "string", "minLength": 1},
      "whenUnsatisfiable": {"enum": ["DoNotSchedule", "ScheduleAnyway"]},
      "labelSelector": {"type": "object"}
    }}},
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "digest", "pullPolicy"], "properties": {
      "repository": {"type": "string", "minLength": 1},
      "tag": {"$ref": "#/definitions/tag"},
      "digest": {"$ref": "#/definitions/digest"},
      "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
    }},
    "agentImage": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "digest"], "properties": {
      "repository": {"type": "string"},
      "tag": {"$ref": "#/definitions/tag"},
      "digest": {"$ref": "#/definitions/digest"}
    }},
    "imagePullSecrets": {"type": "array", "uniqueItems": true, "items": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {"name": {"$ref": "#/definitions/secretName"}}}},
    "agent": {"type": "object", "additionalProperties": false, "required": ["imagePullSecrets"], "properties": {
      "imagePullSecrets": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/secretName"}},
      "resources": {"type": ["object", "null"], "additionalProperties": false, "properties": {
        "requests": {"$ref": "#/definitions/resourceList"},
        "limits": {"$ref": "#/definitions/resourceList"},
        "claims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {
          "name": {"type": "string"}, "request": {"type": "string"}
        }}}
      }}
    }},
    "resources": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "headscale": {"type": "object", "additionalProperties": false, "required": ["caConfigMapRef"], "properties": {
      "caConfigMapRef": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {
        "name": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
        "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$"}
      }}
    }},
    "policy": {"type": "object", "additionalProperties": false, "required": ["fragmentReader"], "properties": {
      "fragmentReader": {"type": "object", "additionalProperties": false, "required": ["enabled", "configMaps"], "properties": {
        "enabled": {"type": "boolean"},
        "configMaps": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"}}
      }}
    }},
    "console": {"type": "object", "additionalProperties": false, "required": ["enabled", "accessManagement", "url", "oidc", "resources", "networkPolicy"], "properties": {
      "enabled": {"type": "boolean"},
      "accessManagement": {"type": "object", "additionalProperties": false, "required": ["enabled", "fourEyes", "retentionDays", "audit"], "properties": {
        "enabled": {"type": "boolean"},
        "fourEyes": {"type": "boolean"},
        "retentionDays": {"type": "integer", "minimum": 0, "maximum": 3650},
        "audit": {"type": "object", "additionalProperties": false, "required": ["size", "storageClassName", "existingClaim"], "properties": {
          "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
          "storageClassName": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
          "existingClaim": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"}
        }}
      }},
      "url": {"type": "string", "pattern": "^$|^https://[^\\s/?#]+/?$"},
      "oidc": {"type": "object", "additionalProperties": false, "required": ["issuer", "clientID", "clientSecretRef", "scopes", "adminGroup", "userGroup"], "properties": {
        "issuer": {"type": "string", "pattern": "^$|^https://[^\\s?#]+$"},
        "clientID": {"type": "string"},
        "clientSecretRef": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {
          "name": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
          "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$"}
        }},
        "scopes": {"type": "array", "contains": {"const": "openid"}, "items": {"type": "string", "pattern": "^[!#-\\[\\]-~]+$"}},
        "adminGroup": {"type": "string"},
        "userGroup": {"type": "string"}
      }},
      "resources": {"type": "object", "additionalProperties": false, "properties": {"requests": {"$ref": "#/definitions/resourceList"}, "limits": {"$ref": "#/definitions/resourceList"}}},
      "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["idpCIDRs", "idpPorts", "ingressPeers"], "properties": {
        "idpCIDRs": {"$ref": "#/definitions/cidrs"},
        "idpPorts": {"$ref": "#/definitions/ports"},
        "ingressPeers": {"$ref": "#/definitions/peers"}
      }}
    }},
    "env": {"type": "object", "additionalProperties": false, "required": ["extra"], "properties": {"extra": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}}}},
    "monitoring": {"type": "object", "additionalProperties": false, "required": ["serviceMonitor", "podMonitor", "rules", "dashboard"], "properties": {
      "serviceMonitor": {"type": "object", "additionalProperties": false, "required": ["enabled", "labels", "interval"], "properties": {"enabled": {"type": "boolean"}, "labels": {"$ref": "#/definitions/labels"}, "interval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"}}},
      "podMonitor": {"type": "object", "additionalProperties": false, "required": ["enabled", "labels", "namespaceSelector", "interval", "scrapeFrom"], "properties": {
        "enabled": {"type": "boolean"}, "labels": {"$ref": "#/definitions/labels"},
        "scrapeFrom": {"type": "array", "items": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"namespaceSelector": {"type": "object"}, "podSelector": {"type": "object"}, "ipBlock": {"type": "object"}}}},
        "namespaceSelector": {"type": "object", "additionalProperties": false, "properties": {"any": {"type": "boolean"}, "matchNames": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"}
      }},
      "rules": {"type": "object", "additionalProperties": false, "required": ["enabled", "groups", "apiKeyExpiryWarningSeconds", "authKeyExpiryWarningSeconds"], "properties": {
         "enabled": {"type": "boolean"}, "groups": {"type": "array", "items": {"type": "object"}},
         "apiKeyExpiryWarningSeconds": {"type": "integer", "minimum": 1},
         "authKeyExpiryWarningSeconds": {"type": "integer", "minimum": 1}
       }},
      "dashboard": {"type": "object", "additionalProperties": false, "required": ["enabled", "kind", "json", "labels", "instanceSelector", "folder", "allowCrossNamespaceImport", "datasourceName"], "properties": {
        "enabled": {"type": "boolean"}, "json": {"type": "string"}, "labels": {"$ref": "#/definitions/labels"},
        "kind": {"enum": ["GrafanaDashboard", "ConfigMap"]},
        "instanceSelector": {"type": "object", "additionalProperties": false, "required": ["matchLabels"], "properties": {"matchLabels": {"$ref": "#/definitions/labels"}}},
        "folder": {"type": "string", "minLength": 1}, "allowCrossNamespaceImport": {"type": "boolean"}, "datasourceName": {"type": "string", "minLength": 1}
      }}
    }},
    "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["enabled", "provider", "cilium", "kubeAPICIDRs", "kubeAPIPorts", "headscaleCIDRs", "headscalePorts", "spokePeers", "spokeCIDRs", "spokePorts", "dnsPeers", "metricsPeers"], "properties": {
      "enabled": {"type": "boolean"},
      "provider": {"enum": ["kubernetes", "cilium"]},
      "cilium": {"type": "object", "additionalProperties": false, "required": ["headscalePeers"], "properties": {"headscalePeers": {"$ref": "#/definitions/peers"}}},
      "kubeAPICIDRs": {"$ref": "#/definitions/cidrs"},
      "kubeAPIPorts": {"$ref": "#/definitions/ports"},
      "headscaleCIDRs": {"$ref": "#/definitions/cidrs"},
      "headscalePorts": {"$ref": "#/definitions/ports"},
      "spokePeers": {"$ref": "#/definitions/peers"},
      "spokeCIDRs": {"$ref": "#/definitions/cidrs"},
      "spokePorts": {"$ref": "#/definitions/ports"},
      "dnsPeers": {"$ref": "#/definitions/peers"},
      "metricsPeers": {"$ref": "#/definitions/peers"}
    }}
  },
  "allOf": [{
    "if": {"properties": {"replicas": {"minimum": 2}}},
    "then": {"properties": {"leaderElection": {"properties": {"enabled": {"const": true}}}}}
  }],
  "definitions": {
    "resourceList": {"type": ["object", "null"], "additionalProperties": {"anyOf": [
      {"type": "string", "minLength": 1}, {"type": "number", "minimum": 0}
    ]}},
    "secretName": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
    "tag": {"type": "string", "maxLength": 128, "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$"},
    "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "cidrs": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}},
    "ports": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
    "peers": {"type": "array", "items": {"type": "object"}}
  }
}
